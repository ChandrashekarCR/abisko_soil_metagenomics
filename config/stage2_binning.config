// Stage 2: Binning and Taxonomy from Assembly Input
// Run after Stage 1 assemblies are complete

plugins {
    id 'nf-boost'
}

boost {
    enabled = true
    cleanup = true
    cleanupInterval = '180s'
    cleanupMode = 'conservative'
    cleanupOnComplete = true
}

params {
    // Profile metadata
    config_profile_name        = 'Abisko Stage 2 - Binning & Taxonomy'
    config_profile_description = 'Stage 2: Assembly input → Binning → GTDB-Tk'

    // Input: Use assemblies from Stage 1
    input       = '/home/inf-21-2024/nbis/samplesheet/kf_top/kf_top_samplesheet.csv'
    assembly_input = '/home/inf-21-2024/nbis/samplesheet/kf_top/kf_top_assembly_samplesheet.csv'
    outdir      = '/home/inf-21-2024/nbis/results'
    
    single_end = false
    coassemble_group = false
    
    // Skip QC & Assembly - using existing assemblies
    skip_clipping = true
    skip_trimming = true
    skip_adapter_trimming = true
    skip_spades = true
    skip_spadeshybrid = true
    skip_megahit = true
    skip_metamdbg = true
    skip_flye = true
    skip_quast = false
    
    // Gene Prediction: Enable
    skip_prodigal = false
    skip_prokka = true
    skip_metaeuk = true
    
    // Binning: Enable all
    skip_binning = false
    skip_metabat2 = false
    skip_maxbin2 = false
    skip_concoct = false
    binning_map_mode = 'group'
    min_contig_size = 1500
    bin_min_size = 200000
    refine_bins_dastool = true
    refine_bins_dastool_threshold = 0.3
    postbinning_input = 'both'
    
    // Bin Quality Check: Enable
    skip_binqc = false
    binqc_tool = 'busco'
    busco_db_lineage = 'auto'
    busco_clean = true
    save_busco_db = true
    
    // Taxonomic Classification: Enable
    skip_gtdbtk = false
    gtdb_db = '/home/inf-21-2024/nbis/databases/gtdb-tk/gtdbtk_r220_data'
    gtdbtk_min_completeness = 10
    gtdbtk_max_contamination = 50
    gtdbtk_min_perc_aa = 10
    gtdbtk_min_af = 0.65
    gtdbtk_pplacer_cpus = 32
    gtdbtk_pplacer_useram = true
    
    // Resource Configuration
    max_cpus = 250
    max_memory = '2000.GB'
    max_time = '240.h'
    
    multiqc_title = 'Abisko Stage 2 - Binning & Taxonomy'
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/home/inf-21-2024/nbis/.singularity_cache'
    runOptions = '--bind /home/inf-21-2024/nbis/databases:/home/inf-21-2024/nbis/databases'
    envWhitelist = 'SINGULARITY_TMPDIR,APPTAINER_TMPDIR'
}

process {
    cpus = 8
    memory = 32.GB
    time = 12.h
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 2
    
    withName: 'NFCORE_MAG:MAG:PRODIGAL' {
        cpus = 24; memory = 96.GB; time = 72.h
    }
    
    withName: 'NFCORE_MAG:MAG:BINNING_PREPARATION:SHORTREAD_BINNING_PREPARATION:BOWTIE2_ASSEMBLY_BUILD' {
        cpus = 16; memory = 64.GB; time = 8.h
    }
    
    withName: 'NFCORE_MAG:MAG:BINNING_PREPARATION:SHORTREAD_BINNING_PREPARATION:BOWTIE2_ASSEMBLY_ALIGN' {
        cpus = 64; memory = 192.GB; time = 48.h
        errorStrategy = 'retry'; maxRetries = 2
    }
    
    withName: 'NFCORE_MAG:MAG:BINNING:METABAT2_METABAT2' {
        cpus = 32; memory = 128.GB; time = 24.h
    }
    
    withName: 'NFCORE_MAG:MAG:BINNING:MAXBIN2' {
        cpus = 128; memory = 512.GB; time = 72.h
        errorStrategy = 'ignore'
    }
    
    withName: 'NFCORE_MAG:MAG:BINNING:CONCOCT_CONCOCT' {
        cpus = 48; memory = 256.GB; time = 48.h
    }
    
    withName: 'NFCORE_MAG:MAG:BINNING_REFINEMENT:DASTOOL_DASTOOL' {
        cpus = 48; memory = 128.GB; time = 24.h
        errorStrategy = 'ignore'
    }
    
    withName: 'NFCORE_MAG:MAG:BIN_QC:BUSCO_BUSCO' {
        cpus = 24; memory = 96.GB; time = 24.h
        errorStrategy = 'ignore'
    }
    
    withName: 'NFCORE_MAG:MAG:GTDBTK:GTDBTK_CLASSIFYWF' {
        cpus = 80; memory = 480.GB; time = 48.h
    }
}

executor {
    name = 'local'
    cpus = 250
    memory = '2000 GB'
    queueSize = 40
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/stage2_execution_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/stage2_execution_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/stage2_execution_trace.txt"
}
